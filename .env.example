# Database (use Neon.tech for cloud PostgreSQL)
DATABASE_URL=postgresql://dreamapt:dreamapt@localhost:5432/dreamapt

# Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

# OpenAI
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

# 2GIS
TWOGIS_API_KEY=your-2gis-key-here

# App URLs
FRONTEND_URL=http://localhost:3002
NODE_ENV=development

# Krisha parser tuning
KRISHA_MAX_PAGES=10
KRISHA_MAX_DETAILS=120
KRISHA_RATE_LIMIT_MS=1500
KRISHA_MAX_CONCURRENT=3
KRISHA_DETAIL_TIMEOUT_MS=15000
KRISHA_RESERVOIR=200
PARSER_MAX_RESULTS=150

# Frontend env (prefix with NEXT_PUBLIC_ for client-side access)
NEXT_PUBLIC_API_URL=http://localhost:3003/api
