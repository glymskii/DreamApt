# Database (use Neon.tech for cloud PostgreSQL)
DATABASE_URL=postgresql://dreamapt:dreamapt@localhost:5432/dreamapt

# Auth
# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Backend refuses to start in prod if this is missing or shorter than 32 chars
# or set to a known default ("dreamapt-dev-secret", "change-me").
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
# Admin user is created automatically on first start. Set a strong password
# (≥12 chars, mix of cases / digits / symbols). If changed, the admin's
# password is rotated on next backend boot.
ADMIN_PASSWORD=replace-with-strong-password
# Optional: phone-based admin identity. If set, admin's username AND phone
# become this number, so login uses the same phone field as regular users.
# Existing "admin"-username rows are migrated in-place on boot — id stays.
ADMIN_PHONE=+77078388077

# OpenAI
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

# 2GIS
TWOGIS_API_KEY=your-2gis-key-here

# App URLs
FRONTEND_URL=http://localhost:3002
NODE_ENV=development

# Krisha parser tuning
KRISHA_MAX_PAGES=10
KRISHA_MAX_DETAILS=120
KRISHA_RATE_LIMIT_MS=1500
KRISHA_MAX_CONCURRENT=3
KRISHA_DETAIL_TIMEOUT_MS=15000
KRISHA_RESERVOIR=200
PARSER_MAX_RESULTS=150

# Concurrent search pipelines per backend instance. Each search uses
# 50-100MB peak; 2 fits comfortably in Render Starter (512MB). Anything
# beyond risks OOM kills. Set higher only if you upgrade the plan.
MAX_CONCURRENT_SEARCHES=2

# Postgres connection pool size. TypeORM default is 10 — too low under
# load. 30 buys headroom for ~150 concurrent in-flight requests with the
# map-data cache layer in front. Verify your Postgres plan allows it.
DB_POOL_MAX=30

# Frontend env (prefix with NEXT_PUBLIC_ for client-side access)
NEXT_PUBLIC_API_URL=http://localhost:3003/api
